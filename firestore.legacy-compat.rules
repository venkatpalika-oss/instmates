rules_version = '2';

// =====================================================================
// InstMates website – Firestore Security Rules – LEGACY-COMPATIBLE VARIANT
// ROLLBACK/CONTINGENCY ONLY. Identical to firestore.rules except profile get
// also allows documents that lack profileStatus (public unless
// publicProfile == false). Not the intended production state (owner/CTO
// decision, W0 data gate item 11).
//
// Collections actually used by the deployed site (audit 2026-09-05):
//   users/{uid}                     account document (contains email)
//   profiles/{uid}                  public professional profile
//   posts/{postId}                  feed posts
//   posts/{postId}/comments/{id}    comments
//   posts/{postId}/comments/{id}/replies/{id}
//
// Everything else (questions, answers, chats, messages, notifications,
// signatureCases, caseStudies) has never had a rule and stays denied.
// Enabling those features is a product decision, not a W0 fix.
//
// Principles
//   - Privileged identity fields (isVerified, verified, role, admin,
//     moderator, subscription/entitlement/plan) are NEVER client-writable.
//   - Owner writes are allow-listed by key, not deny-listed.
//   - Privacy is enforced here, never by page JavaScript.
//   - Rules are not filters: list queries on profiles must carry
//     where("profileStatus.isPublic", "==", true).
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= HELPERS =================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function isStr(v, max) {
      return v is string && v.size() <= max;
    }

    function isOptStr(v, max) {
      return v == null || isStr(v, max);
    }

    function isStrList(v, max) {
      return v is list && v.size() <= max;
    }

    // Keys that must never be set by a client on any user-owned document.
    // (Kept as an explicit list in addition to the allow-lists below so the
    // intent survives future edits.)
    function touchesPrivilegedKey(keys) {
      return keys.hasAny([
        'isVerified', 'verified', 'verifiedAt', 'verificationStatus',
        'role', 'roles', 'isAdmin', 'admin', 'isModerator', 'moderator',
        'subscription', 'subscriptionTier', 'entitlement', 'entitlements',
        'plan', 'isPro', 'pro', 'claims', 'stats'
      ]);
    }

    // ================= USERS =================
    // Account document. Carries the member's email, so it is OWNER-ONLY to
    // read (previously any signed-in user could enumerate every email).
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && incoming().keys().hasOnly([
             'uid', 'name', 'email', 'role', 'verified', 'profileCompleted',
             'followersCount', 'followingCount', 'postsCount', 'createdAt'
           ])
        && incoming().uid == userId
        && isStr(incoming().name, 100)
        && incoming().email == request.auth.token.email
        && incoming().role == 'user'
        && incoming().verified == false
        && incoming().profileCompleted == false
        && incoming().followersCount == 0
        && incoming().followingCount == 0
        && incoming().postsCount == 0;

      // The only owner update path in the site sets profileCompleted /
      // updatedAt (and, historically, name). Counters, role, verified and
      // email cannot be changed from the client.
      allow update: if isOwner(userId)
        && incoming().diff(resource.data).affectedKeys()
             .hasOnly(['name', 'profileCompleted', 'updatedAt'])
        && (!('name' in incoming()) || isStr(incoming().name, 100))
        && (!('profileCompleted' in incoming()) || incoming().profileCompleted is bool);

      allow delete: if false;
    }

    // ================= PROFILES =================
    // Public professional profile. Two document shapes exist in production:
    //   nested: { basicInfo{...}, professional{...}, achievement{...},
    //             profileStatus{ isPublic, completionPercent, lastUpdated } }
    //   legacy: { fullName, role, bio, skills, ... } (created by the
    //             restoreProfiles admin function; no profileStatus key)
    match /profiles/{userId} {

      // Single-document read: public when profileStatus.isPublic == true.
      // Legacy documents without profileStatus keep their pre-W0 behaviour
      // (public unless publicProfile == false) so existing links do not break.
      // Owners can always read their own document.
      allow get: if isOwner(userId)
        || (resource.data.get('profileStatus', {}).get('isPublic', null) == true)
        || (!('profileStatus' in resource.data)
            && resource.data.get('publicProfile', true) != false);

      // Listing: only queries constrained to public profiles are allowed.
      // Legacy documents (no profileStatus) are not listable; they remain
      // reachable by direct link via the get rule above.
      allow list: if resource.data.profileStatus.isPublic == true;

      allow create: if isOwner(userId)
        && incoming().keys().hasOnly([
             'basicInfo', 'professional', 'achievement', 'profileStatus', 'createdAt'
           ])
        && validProfileMaps(incoming());

      // Owner edits may only touch the four profile maps. Any attempt to add
      // or change isVerified / verified / role / stats / etc. is rejected.
      allow update: if isOwner(userId)
        && incoming().diff(resource.data).affectedKeys()
             .hasOnly(['basicInfo', 'professional', 'achievement', 'profileStatus'])
        && !touchesPrivilegedKey(incoming().diff(resource.data).affectedKeys())
        && validProfileMaps(incoming());

      allow delete: if false;
    }

    function validProfileMaps(d) {
      return validBasicInfo(d.get('basicInfo', null))
        && validProfessional(d.get('professional', null))
        && validAchievement(d.get('achievement', null))
        && validProfileStatus(d.get('profileStatus', null));
    }

    function validBasicInfo(b) {
      return b == null
        || (b is map
            && b.keys().hasOnly(['fullName', 'headline', 'location', 'profilePhoto',
                                 'experienceYears', 'company'])
            && isOptStr(b.get('fullName', null), 100)
            && isOptStr(b.get('headline', null), 150)
            && isOptStr(b.get('location', null), 100)
            && isOptStr(b.get('company', null), 100)
            && (b.get('experienceYears', null) == null
                || (b.experienceYears is number
                    && b.experienceYears >= 0 && b.experienceYears <= 60))
            && (b.get('profilePhoto', null) == null
                || (isStr(b.profilePhoto, 2048)
                    && b.profilePhoto.matches('https://firebasestorage\\.googleapis\\.com/.*'))));
    }

    function validProfessional(p) {
      return p == null
        || (p is map
            && p.keys().hasOnly(['specialization', 'analyzersWorked', 'plantType',
                                 'certifications'])
            && isOptStr(p.get('specialization', null), 150)
            && isOptStr(p.get('plantType', null), 100)
            && (p.get('analyzersWorked', null) == null || isStrList(p.analyzersWorked, 50))
            && (p.get('certifications', null) == null || isStrList(p.certifications, 50)));
    }

    function validAchievement(a) {
      return a == null
        || (a is map
            && a.keys().hasOnly(['title', 'description', 'impact'])
            && isOptStr(a.get('title', null), 200)
            && isOptStr(a.get('description', null), 2000)
            && isOptStr(a.get('impact', null), 2000));
    }

    function validProfileStatus(s) {
      return s == null
        || (s is map
            && s.keys().hasOnly(['isPublic', 'completionPercent', 'lastUpdated'])
            && (s.get('isPublic', null) == null || s.isPublic is bool)
            && (s.get('completionPercent', null) == null
                || (s.completionPercent is number
                    && s.completionPercent >= 0 && s.completionPercent <= 100)));
    }

    // ================= POSTS =================
    match /posts/{postId} {
      allow read: if true;

      allow create: if isSignedIn()
        && incoming().keys().hasOnly([
             'content', 'uid', 'type', 'attachment', 'createdAt', 'editedAt',
             'reactions', 'votedBy', 'tags'
           ])
        && incoming().uid == request.auth.uid
        && isStr(incoming().content, 5000)
        && incoming().type in ['question', 'fault', 'solution', 'calibration']
        && incoming().createdAt is timestamp
        && incoming().get('editedAt', null) == null
        && incoming().reactions == {"agree": 0, "faced": 0, "helpful": 0}
        && incoming().votedBy == {}
        && isStrList(incoming().get('tags', []), 5)
        && validAttachment(incoming().get('attachment', null));

      // Owner can edit their own post content
      allow update: if isSignedIn()
        && isOwner(resource.data.uid)
        && incoming().diff(resource.data).changedKeys().hasOnly(['content', 'editedAt'])
        && isStr(incoming().content, 5000);

      // One-time reaction vote (no undo, matches app UI)
      allow update: if isSignedIn()
        && incoming().diff(resource.data).changedKeys().hasOnly(['reactions', 'votedBy'])
        // Pre-W0 the rule read resource.data.votedBy[uid], which throws when
        // the key is absent (i.e. on every first vote) and therefore denied
        // all reactions. get() with a default is the safe form.
        && resource.data.votedBy.get(request.auth.uid, false) != true
        && incoming().votedBy.get(request.auth.uid, false) == true
        && incoming().votedBy.size() == resource.data.votedBy.size() + 1
        && (
          (incoming().reactions.agree == resource.data.reactions.agree + 1
            && incoming().reactions.faced == resource.data.reactions.faced
            && incoming().reactions.helpful == resource.data.reactions.helpful)
          || (incoming().reactions.faced == resource.data.reactions.faced + 1
            && incoming().reactions.agree == resource.data.reactions.agree
            && incoming().reactions.helpful == resource.data.reactions.helpful)
          || (incoming().reactions.helpful == resource.data.reactions.helpful + 1
            && incoming().reactions.agree == resource.data.reactions.agree
            && incoming().reactions.faced == resource.data.reactions.faced)
        );

      // Unchanged in W0: the site has never allowed post deletion. Owner
      // decision pending (see W0 report, section Q).
      allow delete: if false;

      // ================= COMMENTS =================
      match /comments/{commentId} {
        allow read: if true;

        allow create: if isSignedIn()
          && incoming().keys().hasOnly(['content', 'uid', 'createdAt'])
          && incoming().uid == request.auth.uid
          && isStr(incoming().content, 2000)
          && incoming().createdAt is timestamp;

        allow update, delete: if false;

        // ================= REPLIES =================
        match /replies/{replyId} {
          allow read: if true;

          allow create: if isSignedIn()
            && incoming().keys().hasOnly(['content', 'uid', 'createdAt'])
            && incoming().uid == request.auth.uid
            && isStr(incoming().content, 2000)
            && incoming().createdAt is timestamp;

          allow update, delete: if false;
        }
      }
    }

    function validAttachment(a) {
      return a == null
        || (a is map
            && a.keys().hasOnly(['url', 'type', 'name'])
            && isStr(a.url, 2048)
            && a.url.matches('https://firebasestorage\\.googleapis\\.com/.*')
            && a.type in ['image', 'video', 'pdf', 'file']
            && isStr(a.name, 255));
    }

    // ================= DEFAULT DENY =================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
